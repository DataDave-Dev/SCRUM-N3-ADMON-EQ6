---
import Base from '../layouts/Base.astro';
import Globo from '../components/Globo.astro';
import { reglas } from '../data/reglas';
import { ruta } from '../lib/assets';
---

<Base titulo="Cómo se juega">
  <h2>Cómo se juega</h2>
  {reglas.map((r) => <Globo personaje={r.personaje}>{r.texto}</Globo>)}
  <a class="go" href={ruta('/')}>Entendido</a>
</Base>
