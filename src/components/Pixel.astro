---
/** Icono pixel art en SVG; toma el color de `currentColor`. */
type Tipo = 'corazon' | 'estrella' | 'flecha' | 'candado' | 'abajo';

interface Props {
  tipo: Tipo;
  /** Alto en px; el ancho se deriva de la rejilla. */
  alto?: number;
  class?: string;
  /** Texto accesible; sin él el icono es decorativo. */
  label?: string;
}

// [columnas, filas, rectángulos [x, y, ancho, alto]]
const formas: Record<Tipo, [number, number, number[][]]> = {
  corazon: [7, 6, [[1, 0, 2, 1], [4, 0, 2, 1], [0, 1, 7, 2], [1, 3, 5, 1], [2, 4, 3, 1], [3, 5, 1, 1]]],
  estrella: [7, 7, [[3, 0, 1, 2], [1, 2, 5, 1], [0, 3, 7, 1], [1, 4, 5, 1], [2, 5, 1, 1], [4, 5, 1, 1], [1, 6, 1, 1], [5, 6, 1, 1]]],
  flecha: [4, 7, [[0, 0, 1, 7], [1, 1, 1, 5], [2, 2, 1, 3], [3, 3, 1, 1]]],
  candado: [7, 8, [[2, 0, 3, 1], [1, 1, 1, 2], [5, 1, 1, 2], [0, 3, 7, 2], [0, 5, 3, 2], [4, 5, 3, 2], [0, 7, 7, 1]]],
  abajo: [5, 3, [[0, 0, 5, 1], [1, 1, 3, 1], [2, 2, 1, 1]]],
};

const { tipo, alto = 16, class: clase, label } = Astro.props;
const [cols, filas, rects] = formas[tipo];
const a11y = label ? ({ role: 'img', 'aria-label': label } as const) : ({ 'aria-hidden': 'true' } as const);
---

<svg
  class={clase}
  viewBox={`0 0 ${cols} ${filas}`}
  width={Math.round((alto * cols) / filas)}
  height={alto}
  shape-rendering="crispEdges"
  fill="currentColor"
  {...a11y}
>
  {rects.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} />)}
</svg>
